{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm install",
      "type": "shell",
      "command": "npm install",
      "problemMatcher": []
    },
    {
      "label": "Dev",
      "type": "shell",
      "command": "npm run tauri -- dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "tauri-dev",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Watching"
        },
        "pattern": {
          "regexp": "^$"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Dev (HWID)",
      "type": "shell",
      "command": "bash ./scripts/with-hwid.sh npm run tauri -- dev -- --features hwid",
      "dependsOn": ["npm install"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "tauri-dev-hwid",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Watching"
        },
        "pattern": {
          "regexp": "^$"
        }
      }
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "npm run tauri -- build",
      "dependsOn": ["npm install"],
      "problemMatcher": []
    },
    {
      "label": "Build (HWID)",
      "type": "shell",
      "command": "bash ./scripts/with-hwid.sh npm run tauri -- build -- --features hwid",
      "dependsOn": ["npm install"],
      "problemMatcher": []
    }
  ]
}
